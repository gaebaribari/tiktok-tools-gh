# curl-cffi가 설치된 Python 인터프리터 경로 (yt-dlp impersonation용)
# macOS 예: /opt/homebrew/opt/yt-dlp/libexec/bin/python3
# Linux 예: /usr/bin/python3
TIKTOK_PYTHON=

# HTML fetcher 데몬 풀 크기 (기본 3)
TIKTOK_DAEMON_POOL=

# 데몬 stderr 출력 활성화 (디버그용)
TIKTOK_DAEMON_DEBUG=

# yt-dlp 쿠키 옵션 (선택) — TikTok 차단 완화용
# Netscape cookies.txt 경로
TIKTOK_COOKIES_FILE=
# 또는 브라우저에서 직접 (chrome/firefox/safari/edge/brave)
TIKTOK_COOKIES_BROWSER=
